# HTTP port this service listens on for webhooks.
# Pick something free on this box (mediasage uses 5765, smart-plex-queue uses 8000 elsewhere).
PORT=8090

# Path Plex should POST webhooks to. Must match the URL you register in
# Plex Settings -> Webhooks -> Add Webhook (e.g. http://<this-box-ip>:8090/webhook/plex).
PLEX_WEBHOOK_PATH=/webhook/plex

# Comma-separated list of usernames to watch (currently: Plex's "Account.title"
# from the webhook payload). Only playback from these accounts updates WhatsApp status.
WATCHED_USERS=YourPlexUsername

# Optional. Comma-separated list of device/client names to watch (currently:
# Plex's "Player.title" from the webhook payload - the name the Plex client
# itself reports, e.g. "Suneel's iPhone" or "Living Room TV"; can contain
# spaces, matched case-insensitively). Unlike WATCHED_USERS above, leaving
# this EMPTY means "don't filter by device" - playback from any device by a
# watched user still updates WhatsApp status. Only set this if you want to
# additionally restrict to specific devices.
WATCHED_DEVICES=

# Milliseconds to wait after an event before sending a status update, to coalesce rapid skips
DEBOUNCE_MS=2500

# Milliseconds to keep the WhatsApp connection open after the last update before disconnecting
IDLE_DISCONNECT_MS=10000

# If true (default), status is reset to IDLE_STATUS_TEXT when playback pauses/stops.
# If false, the last "now playing" status is left in place until the next play event.
# NOTE: an empty IDLE_STATUS_TEXT does NOT remove the About entry - WhatsApp
# silently ignores an empty-string update - so use a real generic word here.
CLEAR_STATUS_ON_STOP=true
IDLE_STATUS_TEXT=Idle

# Duration (seconds) for the pause/stop fallback text specifically, separate
# from TRACK_DURATION_SEC/VIDEO_DURATION_SEC below. Confirmed by testing:
# 60s actually expires on schedule - a known-good value, not a guess.
IDLE_DURATION_SEC=60

# Emoji for the pause/stop fallback. Confirmed by testing: an empty emoji
# causes WhatsApp to silently ignore the whole update, so this must be
# non-empty even for a generic status with no natural icon.
IDLE_EMOJI=💤

# Folder where the WhatsApp linked-device session is persisted (do not commit this)
AUTH_DIR=./auth

# Emoji + auto-expiry duration (seconds) for music tracks. WhatsApp's
# redesigned About treats emoji as a separate field from the text itself.
# Duration is a safety net (WhatsApp clears the text on its own if we ever
# miss a stop event) - 600s (10 min) approximates a typical song's length.
# Requires the Baileys fork with PR #2755's duration support (see README's
# "Known issue" section); has no effect on stable Baileys.
TRACK_EMOJI=🎵
TRACK_DURATION_SEC=600

# Same, but for movies/TV episodes - much longer runtime, so a longer
# auto-expiry safety net. 5400s (90 min) is a rough movie-length default;
# raise it if you regularly watch longer movies, since the timer isn't
# refreshed mid-playback, only on play/resume/pause/stop events.
VIDEO_EMOJI=🎬
VIDEO_DURATION_SEC=5400

# Optional second source: Spotify. Unlike Plex, Spotify has no webhook - this
# requires OAuth plus polling (see README's Spotify section). Leave these
# empty to disable it entirely; server.js simply never starts the poller.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must exactly match a Redirect URI registered on the app in the Spotify
# Developer Dashboard. Nothing needs to actually be listening on it - see
# npm run link:spotify, which only needs this to complete the one-time OAuth
# consent redirect.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Where the refresh token from `npm run link:spotify` is saved - keep this
# file private and don't commit it, same as AUTH_DIR above.
SPOTIFY_TOKEN_PATH=./spotify-token.json

# Poll interval while something is playing (fast, so track/pause changes are
# caught quickly) vs. while idle/nothing playing (slow, to conserve
# Spotify's undocumented Development Mode quota). Milliseconds.
SPOTIFY_POLL_INTERVAL_MS=10000
SPOTIFY_IDLE_POLL_INTERVAL_MS=60000
