{
  "name": "media-whatsapp-status",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Updates a WhatsApp account's About text with the currently playing track for configured users. Supports Plex (webhook) and Spotify (polling, requires npm run link:spotify).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "link": "node src/link.js",
    "link:spotify": "node src/link-spotify.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "baileys": "github:ayusc/Baileys#9a469c7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  }
}
